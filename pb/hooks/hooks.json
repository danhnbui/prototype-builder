{
  "description": "Product Builder: put the operating rules in front of the model in any pb project and force the common ones through the safe path at call time (route.py: a model on subagent calls, a restorable copy around a hand write of registry.json, one ask before an edit in another project). Advice and force-through only: it never denies a call and never auto-approves one, and enforce=advise|off in memory/doctor.json turns the force-through down. activity.py tells an open preview whether Claude is working (it writes .preview/activity.json and prints nothing)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/session_rules.py"], "timeout": 3 },
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/housekeep.py"], "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/bash_advice.py"], "timeout": 3 }
        ]
      },
      {
        "matcher": "mcp__.*(chrome-devtools|claude-in-chrome).*",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/browser_advice.py"], "timeout": 3 }
        ]
      },
      {
        "matcher": "Bash|Agent|Task|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/route.py"], "timeout": 3 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/activity.py"], "timeout": 3 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/activity.py"], "timeout": 3 }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/route.py"], "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["-S", "-B", "${CLAUDE_PLUGIN_ROOT}/hooks/activity.py"], "timeout": 3 }
        ]
      }
    ]
  }
}
