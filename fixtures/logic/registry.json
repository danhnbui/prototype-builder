 "ia": {
  "populated": true,
  "rules": [
   {
    "id": "order-lifecycle",
    "title": "An order moves Draft to Paid or Void",
    "kind": "state-machine",
    "summary": "An order is Draft until submitted, Approved once an Admin signs it off, then Paid. A submitted order can be sent back to Draft; an approved one can be voided.",
    "stateField": "order.status",
    "states": [
     {
      "key": "draft",
      "label": "Draft",
      "condition": "order.status === 'draft'"
     },
     {
      "key": "submitted",
      "label": "Submitted",
      "condition": "order.status === 'submitted'"
     },
     {
      "key": "approved",
      "label": "Approved",
      "condition": "order.status === 'approved'"
     },
     {
      "key": "paid",
      "label": "Paid",
      "condition": "order.status === 'paid'"
     },
     {
      "key": "void",
      "label": "Void",
      "condition": "order.status === 'void'"
     }
    ],
    "transitions": [
     [
      "draft",
      "submitted"
     ],
     [
      "submitted",
      "approved"
     ],
     [
      "submitted",
      "draft"
     ],
     [
      "approved",
      "paid"
     ],
     [
      "approved",
      "void"
     ]
    ],
    "overlays": [
     {
      "key": "overdue",
      "label": "Overdue",
      "over": [
       "approved"
      ],
      "condition": "today > order.dueOn"
     }
    ],
    "decision": {
     "question": "Can a submitted order go back to Draft?",
     "options": [
      "Yes, until approved",
      "No, void and recreate"
     ],
     "chose": "Yes, until approved",
     "why": "Editors fix typos without losing the order number.",
     "affects": [
      "Orders",
      "Invoices"
     ],
     "decidedOn": "2026-09-10",
     "answeredBy": "Product owner"
    },
    "implementedBy": [
     "orders"
    ],
    "displayedIn": [
     "orders"
    ]
   },
   {
    "id": "role-access",
    "title": "What each role can do",
    "kind": "matrix",
    "summary": "Admin approves and voids; Editor creates and submits; Viewer reads.",
    "axis": "role",
    "rowLabel": "role",
    "rows": [
     "Admin",
     "Editor",
     "Viewer"
    ],
    "cols": [
     "Create",
     "Submit",
     "Approve",
     "Void"
    ],
    "cells": {
     "Admin": {
      "Create": true,
      "Submit": true,
      "Approve": true,
      "Void": true
     },
     "Editor": {
      "Create": true,
      "Submit": true,
      "Approve": false,
      "Void": false
     },
     "Viewer": {
      "Create": false,
      "Submit": false,
      "Approve": false,
      "Void": false
     }
    },
    "blocks": [
     {
      "type": "matrix",
      "axis": "role",
      "rowLabel": "role",
      "rows": [
       "Admin",
       "Editor",
       "Viewer"
      ],
      "cols": [
       "Create",
       "Approve"
      ],
      "cells": {
       "Admin": {
        "Create": true,
        "Approve": true
       },
       "Editor": {
        "Create": true,
        "Approve": false
       },
       "Viewer": {
        "Create": false,
        "Approve": false
       }
      }
     }
    ],
    "displayedIn": [
     "orders"
    ]
   },
   {
    "id": "order-invariants",
    "title": "Order totals stay consistent",
    "kind": "constraint",
    "summary": "Every order obeys these at all times.",
    "invariants": [
     {
      "must": "The total equals the sum of its lines",
      "enforcedBy": "orderTotal",
      "when": "any line changes"
     },
     {
      "must": "An approved order has at least one line",
      "enforcedBy": "approveOrder"
     },
     {
      "must": "A paid order is never edited",
      "message": "Paid orders are read-only."
     },
     {
      "must": "Order numbers are never reused"
     }
    ],
    "implementedBy": [
     "orders"
    ]
   },
